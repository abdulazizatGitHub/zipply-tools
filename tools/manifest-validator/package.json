{
  "name": "@toolforge/manifest-validator",
  "version": "0.0.0",
  "private": true,
  "description": "CI guardrail: validates every tool manifest in the repo against @toolforge/tool-contract.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "manifest-validator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@toolforge/tool-contract": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@toolforge/eslint-config": "workspace:*",
    "@toolforge/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^9.13.0",
    "rimraf": "^6.0.1",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
