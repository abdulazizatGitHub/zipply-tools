{
  "name": "@toolforge/create-tool",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffolds a new tool conforming to @toolforge/tool-contract. The factory that makes tool #50 a 2-day job.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "create-tool": "./dist/cli.js"
  },
  "scripts": {
