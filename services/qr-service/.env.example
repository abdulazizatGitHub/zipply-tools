# qr-service environment template.
# Copy to .env (gitignored) and fill in values for local dev.
# Production secrets come from Doppler/Infisical, never from .env in repo.

NODE_ENV=development
PORT=8082
HOST=0.0.0.0
LOG_LEVEL=info

# CORS — comma-separated origins. "*" only allowed in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit (per minute, per IP). Override per route in code.
RATE_LIMIT_MAX=200
RATE_LIMIT_TIMEWINDOW_MS=60000

# OTel
OTEL_SERVICE_NAME=qr-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
