# pdf-service environment template.
# Copy to .env (gitignored) and fill in values for local dev.
# Production secrets come from Doppler/Infisical, never from .env in repo.

NODE_ENV=development
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info

# CORS — comma-separated origins. "*" only allowed in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit (per minute, per IP). Override per route in code.
RATE_LIMIT_MAX=120
RATE_LIMIT_TIMEWINDOW_MS=60000

# Phase 2: replaced by HTTP @toolforge/files-client pointing at services/files.
# For now, tools use an in-memory FilesClient and a dev-only upload route.
ENABLE_DEV_UPLOAD_ROUTE=true

# OTel
OTEL_SERVICE_NAME=pdf-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
