# api-gateway environment template.
# Copy to .env (gitignored) and fill in values for local dev.
# Production secrets come from Doppler/Infisical, never from .env in repo.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Downstream services (local docker-compose defaults).
IDENTITY_BASE_URL=http://identity:8080
PDF_SERVICE_URL=http://localhost:8081
QR_SERVICE_URL=http://localhost:8082

# CORS — comma-separated origins. "*" only allowed in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit (per minute, per IP). Override per route in code.
RATE_LIMIT_MAX=120
RATE_LIMIT_TIMEWINDOW_MS=60000

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=api-gateway
OTEL_RESOURCE_ATTRIBUTES=service.namespace=toolforge,deployment.environment=local
