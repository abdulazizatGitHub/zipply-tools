# ============================================================================
# ToolForge — root .env.example
# ----------------------------------------------------------------------------
# This file is the single source of truth for environment variable *names*.
# It is committed; real values are NOT.
#
# Conventions:
#   - Prefix variables with their service (WEB_, API_GATEWAY_, IDENTITY_, etc.)
#   - Platform-wide variables use the TOOLFORGE_ prefix.
#   - Secret values: TOOLFORGE_<NAME>_SECRET — fetched from secret manager in prod.
#   - Public values (exposed to browser): MUST be prefixed NEXT_PUBLIC_ or PUBLIC_.
#
# Each service has its own .env.example documenting only the vars it consumes.
# Validation happens at process startup via @toolforge/env (Zod) — never trust
# `process.env` directly.
# ============================================================================

# ---- Platform-wide ---------------------------------------------------------
NODE_ENV=development
TOOLFORGE_ENV=local                          # local | preview | staging | production
TOOLFORGE_REGION=us-east-1
LOG_LEVEL=debug                              # trace | debug | info | warn | error | fatal

# ---- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=                           # set per-service
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1                  # 10% sampling default; 1.0 in dev

# ---- Telemetry vendors (optional in dev) -----------------------------------
SENTRY_DSN=
POSTHOG_KEY=

# ---- Datastores (local docker-compose values) ------------------------------
DATABASE_URL=postgres://toolforge:toolforge@localhost:5432/toolforge
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123

# ---- Object storage (Cloudflare R2 / S3 compatible) ------------------------
STORAGE_ENDPOINT=http://localhost:9000       # MinIO in local dev
STORAGE_REGION=auto
STORAGE_BUCKET=toolforge-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# ---- Auth (Clerk in foundation phase) --------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Billing (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI providers (consumed only by ai-gateway service) --------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Web (apps/web) --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
