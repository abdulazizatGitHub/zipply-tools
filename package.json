{
  "name": "toolforge",
  "version": "0.0.0",
  "private": true,
  "description": "ToolForge — scalable online tools ecosystem (monorepo root)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "depcheck": "turbo run depcheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,jsx,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "deps:graph": "dpdm --no-warning --no-tree --exit-code circular:1 \"packages/**/src/**/*.{ts,tsx}\" \"services/**/src/**/*.ts\" \"apps/**/{app,src}/**/*.{ts,tsx}\"",
    "scaffold:tool": "pnpm --filter @toolforge/create-tool start",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@toolforge/prettier-config": "workspace:*",
    "dpdm": "^3.14.0",
    "lefthook": "^1.7.22",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  }
}
